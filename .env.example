# Copy this file to .env and fill in the values from the lab environment handout
# your trainer gives you, then set LAB_ALIAS to your own short name.
#
#   Windows:  Copy-Item .env.example .env
#
# LAB_ALIAS must be 2-12 characters, lowercase letters and digits only.
# Use your lab username (for example fdeuser7) so it is unique.

LAB_ALIAS=changeme

# --- from the lab environment handout -------------------------------------
PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project-name>
SEARCH_ENDPOINT=https://<search-service>.search.windows.net
STORAGE_ACCOUNT=<storage-account>
FOUNDRY_NAME=<foundry-resource>
PROJECT_NAME=<project-name>
RESOURCE_GROUP=<resource-group>
SUBSCRIPTION_ID=<subscription-id>

# --- the same for everyone -------------------------------------------------
SEARCH_API_VERSION=2026-08-01-preview
CORPUS_CONTAINER=corpus
CHAT_DEPLOYMENT=gpt-5.2
MINI_DEPLOYMENT=gpt-5.4-mini
EMBED_DEPLOYMENT=text-embedding-3-large
